{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build tree",
            "type": "shell",
            "command": "make -j",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "./tree with CPU and CUDA backends (g++ + nvcc)."
        },
        {
            "label": "Build tree (CPU only)",
            "type": "shell",
            "command": "make -j cpu",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "detail": "./tree_cpu without CUDA."
        },
        {
            "label": "Build tree (clean)",
            "type": "shell",
            "command": "make clean",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "Remove build/, tree and tree_cpu."
        },
        {
            "label": "Check backends agree",
            "type": "shell",
            "command": "tests/check_backends.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "dependsOn": "Build tree"
        }
    ]
}
