 ],
 "protocols": {
  "cart_full": {
   "title": "CART, grown to pure leaves (depth <= 30), no pruning",
   "impls": {
    "tree": [
     "--cart",
     "--no-prune",
     "-d",
     "30"
    ],
    "sklearn": {
     "mode": "fit",
     "max_depth": 30
    },
    "rpart": {
     "mode": "fit",
     "maxdepth": 30
    },
    "tree_cuda": [
     "--cart",
     "--no-prune",
     "-d",
     "30"
    ]
   }
  },
  "cart_depth12": {
   "title": "CART, grown to depth 12, no pruning",
   "impls": {
    "tree": [
     "--cart",
     "--no-prune",
     "-d",
     "12"
    ],
    "sklearn": {
     "mode": "fit",
     "max_depth": 12
    },
    "rpart": {
     "mode": "fit",
     "maxdepth": 12
    },
    "tree_cuda": [
     "--cart",
     "--no-prune",
     "-d",
     "12"
    ]
   }
  },
  "cart_alpha": {
   "title": "CART, one tree pruned at a fixed alpha (cost-complexity)",
   "impls": {
    "tree": [
     "--cart",
     "-d",
     "30",
     "--alpha",
     "{alpha}"
    ],
    "sklearn": {
     "mode": "fit",
     "max_depth": 30,
     "ccp_alpha": "{alpha}"
    },
    "rpart": {
     "mode": "alpha",
     "maxdepth": 30,
     "alpha": "{alpha}"
    },
    "tree_cuda": [
     "--cart",
     "-d",
     "30",
     "--alpha",
     "{alpha}"
    ]
   }
  },
  "cart_alpha_nodepth": {
   "title": "CART, one tree pruned at a fixed alpha (cost-complexity), no depth limit",
   "impls": {
    "tree": [
     "--cart",
     "--alpha",
     "{alpha}"
    ],
    "tree_cuda": [
     "--cart",
     "--alpha",
     "{alpha}"
    ]
   }
  },
  "c45": {
   "title": "C4.5, error-based pruning (CF 0.25, subtree raising), min 2 rows",
   "impls": {
    "tree": [
     "--c45"
    ],
    "j48": {
     "options": "-C 0.25 -M 2"
    },
    "yadt": [
     "-ebpg",
     "-c",
     "0.25",
     "-m",
     "2"
    ],
    "tree_cuda": [
     "--c45"
    ]
   }
  },
  "c45_unpruned": {
   "title": "C4.5, unpruned (only C4.5's collapse of useless splits), min 2 rows",
   "impls": {
    "tree": [
     "--c45",
     "--no-prune"
    ],
    "j48": {
     "options": "-U -M 2"
    },
    "yadt": [
     "-np",
     "-m",
     "2"
    ],
    "tree_cuda": [
     "--c45",
     "--no-prune"
    ]
   }
  }
 },
